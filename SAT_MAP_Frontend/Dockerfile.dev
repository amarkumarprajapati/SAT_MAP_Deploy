FROM node:22-alpine

WORKDIR /app

# Enable hot reload polling on Windows Docker Desktop mounts
ENV WATCHPACK_POLLING=true
ENV WATCHPACK_POLLING_INTERVAL=3000
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 3000

# Use webpack in the Windows bind-mounted dev container so WATCHPACK_POLLING
# reliably detects host file changes and Next.js can apply HMR without restarts.
CMD ["npm", "run", "dev", "--", "--webpack"]
